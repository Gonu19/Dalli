{
  "expo": {
    "name": "달리",
    "slug": "dalli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dalli",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dalli.app",
      "infoPlist": {
        "NSMotionUsageDescription": "러닝 케이던스 측정을 위해 동작 데이터를 사용합니다.",
        "NSLocationWhenInUseUsageDescription": "러닝 거리와 페이스 측정을 위해 위치를 사용합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "백그라운드 러닝 기록을 위해 위치를 사용합니다.",
        "NSCameraUsageDescription": "러닝 결과 이미지에 사용할 사진을 촬영하기 위해 카메라에 접근합니다.",
        "NSPhotoLibraryUsageDescription": "러닝 결과 이미지에 사용할 사진을 선택하기 위해 사진 보관함에 접근합니다.",
        "NSPhotoLibraryAddUsageDescription": "만든 러닝 결과 이미지를 사진 보관함에 저장하기 위해 접근합니다.",
        "UIBackgroundModes": [
          "audio",
          "location"
        ]
      }
    },
    "android": {
      "package": "com.dalli.app",
      "adaptiveIcon": {
        "backgroundColor": "#EEF3F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "러닝 거리와 페이스 측정을 위해 위치를 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": "화면을 꺼도 러닝 거리가 이어지도록 위치를 사용합니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "러닝 결과 이미지에 사용할 사진을 선택하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "러닝 결과 이미지에 사용할 사진을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F6"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "결과 이미지에 사용할 사진을 고르기 위해 사진 보관함에 접근합니다.",
          "savePhotosPermission": "만든 결과 이미지를 사진 보관함에 저장하기 위해 접근합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
